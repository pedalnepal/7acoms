APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# --- Cybersource Unified Checkout (registration payments) ---
# Credentials come from the Business Center:
#   Payment Configuration > Key Management > REST Shared Secret
CYBS_ENVIRONMENT=test
CYBS_MERCHANT_ID=
CYBS_API_KEY_ID=
CYBS_API_SECRET_KEY=

# Every origin that hosts the checkout page, comma separated.
# Each MUST be https with a fully qualified domain name -- the gateway refuses
# plain http, "localhost", and IP addresses. Defaults to APP_URL when empty.
#   e.g. CYBS_TARGET_ORIGINS=https://acoms2027.org.np,https://www.acoms2027.org.np
CYBS_TARGET_ORIGINS=

# Client SDK version, MAJOR.MINOR. A bare major such as "1" is rejected.
CYBS_CLIENT_VERSION=1.0

CYBS_COUNTRY=NP
CYBS_LOCALE=en_US
CYBS_ALLOWED_PAYMENT_TYPES=PANENTRY
CYBS_ALLOWED_CARD_NETWORKS=VISA,MASTERCARD,AMEX,JCB,DISCOVER,DINERSCLUB
CYBS_BUTTON_TYPE=PAY

# true = sale (authorise and capture together); false = authorise only.
# The complete mandate: the gateway runs 3-D Secure and then the sale itself,
# and returns one signed result this application verifies.
# Leave CYBS_COMPLETE_MANDATE_TYPE empty to switch the mandate off and have the
# server authorise the transient token instead — no payer authentication.
#   CYBS_COMPLETE_MANDATE_TYPE: AUTH, CAPTURE or PREFER_AUTH
#   CYBS_CONSUMER_AUTH:         NONE, 3DS or PASSKEY
CYBS_COMPLETE_MANDATE_TYPE=CAPTURE
CYBS_CONSUMER_AUTH=3DS

# Only used when the complete mandate is off; CAPTURE above already sells.
CYBS_CAPTURE=true

# --- Currency settlement (Nepal Rastra Bank forex) ---
# The bank settles in NPR only, so USD-priced registrations are converted at
# the NRB published rate before they reach the gateway. Leave this empty once
# the bank accepts USD directly -- conversion then stops entirely.
PAYMENT_SETTLEMENT_CURRENCY=NPR

# 'sell' is the rate the bank sells foreign currency at, and the one that
# collects the full USD fee. 'buy' would under-collect by the spread.
FOREX_RATE_TYPE=sell

# Margin over the NRB rate, in percent, to absorb the acquirer's own spread.
# 0 charges exactly the published rate.
FOREX_MARKUP=0

# NRB does not publish every calendar day. The newest rate on or before today
# is used; past this many days it is treated as unusable and checkout stops.
FOREX_MAX_STALE_DAYS=7

# Last resort when nothing is stored and NRB is unreachable. 0 means "stop the
# checkout instead of guessing", which is the safer default.
FOREX_USD_NPR_FALLBACK=0

# --- Super admin seeder (database/seeders/SuperAdminSeeder.php) ---
# Overrides the defaults ("Super Admin" / admin@acoms.test / password) used by
# `php artisan db:seed --class=SuperAdminSeeder`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
